# LoreAI v2 — Environment Variables
# Copy to .env and fill in values

# AI APIs
ANTHROPIC_API_KEY=  # optional — only needed if using API directly; Claude CLI uses Max Plan
MOONSHOT_API_KEY=

# Twitter (twitterapi.io)
TWITTER_API_KEY=
TWITTER_API_SECRET=

# GitHub
GITHUB_TOKEN=

# Reddit OAuth
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Brave Search (free tier, 2000 queries/month)
BRAVE_SEARCH_API_KEY=

# Serper.dev - Google SERP data (https://serper.dev)
SERPER_API_KEY=

# Exa.ai - semantic search & content extraction (https://exa.ai)
EXA_API_KEY=

# Buttondown (newsletter delivery)
BUTTONDOWN_API_KEY=

# Google Search Console (Service Account)
GSC_SERVICE_ACCOUNT_KEY_PATH=  # Path to Google Service Account JSON key
GSC_SITE_URL=sc-domain:loreai.dev  # Search Console property URL

# Dashboard auth secret (must match DASHBOARD_SECRET on VPS)
DASHBOARD_SECRET=

# Database (VPS only, defaults to ./loreai.db)
# DB_PATH=/home/ubuntu/loreai-v2/loreai.db
